# AgentForge sets these from the project's own connected Supabase project (Build setup -> pick a
# Supabase stack) every time it runs a command here - nobody pastes them. This file only documents
# the shape, for running a command outside the Studio: copy it to .env.local and fill in the real
# values from your Supabase project's Settings -> API page.
#
# A brand-new project: `npm run db:create` makes one through the Supabase CLI (it needs the access
# token below and nothing else), and `npm run db:init` then creates the whole database on whichever
# project these values name - the schema, the storage buckets, the policies, the catalogue and the
# first Store Owner.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<project settings -> API -> anon public>
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<project settings -> API -> service_role - server only, never NEXT_PUBLIC_>

# The same public key under the name the CI workflow and the setup scripts read.
SUPABASE_ANON_KEY=<the same value as NEXT_PUBLIC_SUPABASE_ANON_KEY>

# The Postgres connection string, used only by the scripts that build the database (npm run db:init).
# Take it from the project's Connect dialog -> Session pooler. The pooler is reachable over IPv4; the
# direct db.[PROJECT-REF].supabase.co host is IPv6-only on the free plan and will not connect from
# every machine. Percent-encode any reserved character in the password.
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[INDEX]-[REGION].pooler.supabase.com:5432/postgres

# Only for `npm run db:create`, which creates a new Supabase project. Make one at
# supabase.com/dashboard/account/tokens; it is never needed by the running application.
SUPABASE_ACCESS_TOKEN=
# Optional, for that same command: the organization to create the project in (only needed when your
# account has more than one), the region (default ap-south-1, Mumbai), its name (default daraz-ea)
# and its database password (one is generated when this is empty).
SUPABASE_ORG_ID=
SUPABASE_REGION=ap-south-1
SUPABASE_PROJECT_NAME=daraz-ea
SUPABASE_DB_PASSWORD=
